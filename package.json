{
  "name": "jewelry-erp-prototype",
  "private": true,
  "version": "0.1.0",
  "description": "Multi-branch jewelry retail ERP",
  "workspaces": [
    "shared",
    "database",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c yellow,cyan \"npm:dev -w @jerp/backend\" \"npm:dev -w @jerp/frontend\"",
    "build": "npm run build -w @jerp/frontend",
    "start": "npm run start -w @jerp/backend",
    "demo": "node scripts/demo.mjs",
    "db:generate": "npm run generate -w @jerp/database",
    "migrate": "npm run migrate -w @jerp/backend",
    "backup": "npm run backup -w @jerp/backend --",
    "backup:verify": "npm run backup:verify -w @jerp/backend --",
    "typecheck": "npm run check:lockfile && npm run check:hasad && npm run check:migrations && npm run check:drizzle && npm run check:test-imports && tsc -p shared && tsc -p database && tsc -p backend && tsc -p frontend",
    "test": "npm test -w @jerp/backend",
    "i18n:check": "node scripts/i18n-check.mjs",
    "rehearsal": "node scripts/rehearsal/rehearsal.mjs",
    "check:lockfile": "node scripts/check-lockfile-platforms.mjs",
    "check:hasad": "node scripts/check-hasad-footprint.mjs",
    "dev:sample": "npm run dev:sample -w @jerp/backend --",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:drizzle": "node scripts/check-drizzle.mjs",
    "check:test-imports": "node scripts/check-test-imports.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
