# Example environment for a PRODUCTION server (SAFE-1). Copy to the server as the env file read by the service
# (docs/runbooks/first-deploy.md), owned by root, mode 600. Never commit a filled-in copy (.env is git-ignored).
# Every variable is documented in docs/DEPLOYMENT.md section 2. Values in <angle brackets> are placeholders.

# ── Required ─────────────────────────────────────────────────────────────────────────────────────────────────────
APP_MODE=production
# The public https origin users open (no trailing slash). The reverse proxy must pass the Origin header unchanged.
APP_ORIGIN=https://<erp.example.com>
# The app connects as the RUNTIME role (owns nothing; SELECT/INSERT on the append-only tables only).
DATABASE_URL=postgresql://jerp_app:<runtime-password>@127.0.0.1:5432/jewelry_erp
# Migrations run as the OWNER role, over a separate short-lived connection.
MIGRATION_DATABASE_URL=postgresql://jerp_owner:<owner-password>@127.0.0.1:5432/jewelry_erp
# Refuse to start if the runtime role could alter the audit log or the ledgers. Must be set explicitly (true|false).
STRICT_DB_ROLES=true
# Number of reverse-proxy hops in front of the app (1 for one proxy). Must be set explicitly; 0 = no proxy.
TRUST_PROXY=1

# ── Optional (defaults shown) ────────────────────────────────────────────────────────────────────────────────────
PORT=4000
LOG_LEVEL=info
# COOKIE_SECURE: leave unset (true in production; false is refused). PGLITE_DIR: demo only, never on a server.
# WEBAUTHN_RP_ID=<erp.example.com>      # default: the host of APP_ORIGIN. Changing it later invalidates every passkey.
# WEBAUTHN_RP_NAME=<Company name>
# PG_POOL_MAX=10
# PG_STATEMENT_TIMEOUT_MS=30000
# PG_IDLE_IN_TX_TIMEOUT_MS=60000
# PG_CONNECT_TIMEOUT_MS=10000
# PG_IDLE_TIMEOUT_MS=30000
# SHUTDOWN_GRACE_MS=15000

# ── First start only (ignored once the setting exists) ───────────────────────────────────────────────────────────
# ALLOWED_KARATS_INITIAL=<karat list, e.g. 21>
# TWO_FACTOR_REQUIRED_ROLES_INITIAL=GENERAL_MANAGER
# WEBAUTHN_UV_INITIAL=required

# ── Backups: these go in the backup job's own file (/etc/jerp-backup.env, with APP_MODE=production), not here.
#    docs/DEPLOYMENT.md section 7.4. Quote a value that contains spaces (BACKUP_UPLOAD_COMMAND).
# BACKUP_DIR=/var/backups/jerp
# BACKUP_DATABASE_URL=postgresql://jerp_backup:<backup-password>@127.0.0.1:5432/jewelry_erp
# BACKUP_AGE_RECIPIENT=<age1… public key; the secret key is NOT on this server>
# BACKUP_UPLOAD_COMMAND=<copies $BACKUP_FILE $BACKUP_CHECKSUM_FILE $BACKUP_MANIFEST_FILE off-site>
