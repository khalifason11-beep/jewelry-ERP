{
  // GitHub Codespaces: try the app in the browser without installing anything locally.
  // Code → Codespaces → Create codespace. The database starts EMPTY (REM-3): in the codespace terminal run
  // `npm run demo`, answer the General Manager username question, then open port 4000.
  // For a populated database (screenshots) see `npm run dev:sample` in README.md.
  "name": "Jewelry ERP",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "postCreateCommand": "npm install",
  // CLN-1: APP_MODE has no default; a codespace is a local trial installation.
  // CLN-3: the Codespaces port forwarder is exactly one proxy hop and rewrites Origin/Host (it sends the public host in
  // X-Forwarded-Host/-Proto). TRUST_PROXY=1 lets the app read them from that one hop, so passkeys use the public
  // ...app.github.dev address. Do NOT set APP_ORIGIN here: the rewritten Origin would never match it (403 on sign-in).
  "containerEnv": { "APP_MODE": "demo", "TRUST_PROXY": "1" },
  "forwardPorts": [4000],
  "portsAttributes": {
    "4000": { "label": "Jewelry ERP", "onAutoForward": "openBrowser" }
  }
}
